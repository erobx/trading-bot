package view

import (
	"github.com/erobx/trading-bot/pkg/app/model"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
	"strconv"
)

templ page() {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<title>TradeUps</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="/public/styles.css"/>
			<script src="/public/htmx.min.js"></script>
		</head>
		<body class="text-center">
			<div>
				<h1>Active Pools</h1>
			</div>
			<div class="flex flex-wrap justify-center">
				{ children... }
			</div>
		</body>
	</html>
}

templ Groups(groups []model.DisplayGroup) {
	@page() {
		for _, g := range groups {
			@group(g.Tier, g.GroupId, g.Skins)
		}
	}
}

//              Tier
// |   Redline   | Block9 |
// | Safari Mesh | Dragon Lore |
templ group(tier string, gid int, skins []model.Skin) {
	<div class="p-4">
		<h1>
			{ cases.Title(language.English, cases.Compact).String(tier) }
		</h1>
		<div class="grid grid-cols-5 grid-rows-2 gap-2 border-solid border-black border-2">
			for _, s := range skins {
				<div class="container">
					<p>{ s.Name }</p>
					<p>{ s.Wear }</p>
					<p>{ s.Gun }</p>
					<p>${ s.Price.String() }</p>
				</div>
			}
			if len(skins) != 10 {
				for i := 0; i < 10-len(skins); i++ {
					<div class="container">
						@addSkin(gid)
					</div>
				}
			}
		</div>
	</div>
}

templ addSkin(gid int) {
	<form id="newSkinForm" action="/" method="POST">
		<input type="hidden" id="gid" name="gid" value={ strconv.Itoa(gid) }/>
		<input type="hidden" id="sid" name="sid" value="sid"/>
		<div><button class="border-solid border-green-400 border-2 p-1" type="submit">Add Skin</button></div>
	</form>
}
